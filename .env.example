# WiFi Scanner Collector Environment Configuration Example
# Copy this file to .env and update with your values

# InfluxDB Configuration (Required)
WIFISCAN_COLLECTOR_INFLUXDB_URL=http://influxdb:8086
WIFISCAN_COLLECTOR_INFLUXDB_TOKEN=your-influxdb-token-here
WIFISCAN_COLLECTOR_INFLUXDB_ORG=your-org-name
WIFISCAN_COLLECTOR_INFLUXDB_BUCKET=wifiscan
WIFISCAN_COLLECTOR_INFLUXDB_TIMEOUT=30000

# Scanner Configuration
# WIFISCAN_COLLECTOR_WIRELESS_INTERFACE=wlan0  # Optional - auto-detects if not specified
WIFISCAN_COLLECTOR_SCAN_INTERVAL=5
WIFISCAN_COLLECTOR_SCAN_TIMEOUT=30

# Batch Configuration
WIFISCAN_COLLECTOR_BATCH_SIZE=100
WIFISCAN_COLLECTOR_BATCH_INTERVAL=10
WIFISCAN_COLLECTOR_BATCH_RETRY_INTERVAL=5
WIFISCAN_COLLECTOR_FLUSH_ON_SCAN=false  # Flush after each scan for lower data loss risk

# Buffer Management
WIFISCAN_COLLECTOR_MAX_BUFFER_SIZE=10000  # Maximum points to buffer in memory
WIFISCAN_COLLECTOR_MAX_RETRY_ATTEMPTS=10

# Circuit Breaker Configuration
WIFISCAN_COLLECTOR_CIRCUIT_BREAKER_THRESHOLD=5  # Failures before opening circuit
WIFISCAN_COLLECTOR_CIRCUIT_BREAKER_TIMEOUT=300  # Seconds before testing again

# Retry Configuration
WIFISCAN_COLLECTOR_MAX_RETRIES=3
WIFISCAN_COLLECTOR_RETRY_DELAY=2

# Logging Configuration
WIFISCAN_COLLECTOR_LOG_LEVEL=INFO
WIFISCAN_COLLECTOR_STATUS_LOG_INTERVAL=300  # Status summary every N seconds (0=disable)

# Timezone (for Docker container)
TZ=America/Chicago
